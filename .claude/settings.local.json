{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Edit(/**/*)",
      "Read(/**/*)",
      "Bash(tree:*)",
      "Bash(bash:*)",
      "Bash(mkdir:*)",
      "Bash(cd:*)",
      "Bash(chmod:*)",
      "Bash(timeout:*)",
      "Bash(npx:*)",
      "Bash(cat:*)",
      "Bash(./scripts/*.sh:*)",
      "Bash(./scripts/*.cmd:*)",
      "Bash(curl:*)",
      "WebSearch",
      "Bash(tar:*)",
      "Bash(node:*)"
    ],
    "Deny": [
      "Edit(/node_modules/**/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File \".claude\\hooks\\windows-notification.ps1\" -Title \"Claude Code\" -Message \"任务已完成\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File \".claude\\hooks\\windows-notification.ps1\" -Title \"Claude Code\" -Message \"需要权限审批\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File \".claude\\hooks\\windows-notification.ps1\" -Title \"Claude Code\" -Message \"等待你的输入\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
